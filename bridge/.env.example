# 치지직 개발자 센터 애플리케이션
CHZZK_CLIENT_ID=
CHZZK_CLIENT_SECRET=
# 스트리머 채널 ID (heartbeat·로그용). 채팅 구독은 OAuth 로그인한 계정 채널 기준.
CHZZK_CHANNEL_ID=

# Valnce Workers 공개 URL (예: https://valnce.example.workers.dev)
VALNCE_BASE_URL=
# wrangler secret put CHAT_BRIDGE_SECRET 과 동일 값
CHAT_BRIDGE_SECRET=

# OAuth 1회 로그인 (개발자 센터 리디렉션 URL과 동일)
CHZZK_REDIRECT_URI=http://127.0.0.1:8788/callback
CHZZK_LOGIN_PORT=8788
CHZZK_TOKEN_PATH=./data/tokens.json
